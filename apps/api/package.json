{
  "name": "@supplypilot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:check": "tsx scripts/check-database.ts",
    "check:embeddings": "tsx scripts/check-embeddings.ts",
    "check:pgvector": "tsx scripts/check-pgvector.ts",
    "test:db": "tsx scripts/run-db-tests.ts",
    "smoke:openrouter": "tsx scripts/smoke-openrouter.ts",
    "test:e2e": "tsx scripts/run-db-tests.ts --e2e",
    "knowledge:ingest": "tsx scripts/ingest-knowledge.ts",
    "test:rag": "tsx scripts/run-db-tests.ts --rag",
    "smoke:agents": "tsx scripts/run-db-tests.ts --agents",
    "smoke:intents": "tsx scripts/smoke-intents.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph": "^1.0.0",
    "@langchain/openrouter": "^0.4.25",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@supplypilot/contracts": "*",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "langchain": "^1.0.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12",
    "pdfjs-dist": "6.2.108",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "prisma": "^7.0.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "@types/multer": "^2.0.0",
    "pdf-lib": "^1.17.1"
  }
}
