# Copy to .env at the repository root. Replace every placeholder before use.
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
API_PROXY_TARGET=http://127.0.0.1:3001
POSTGRES_USER=supplypilot
POSTGRES_PASSWORD=replace-with-a-generated-database-password
POSTGRES_DB=supplypilot
POSTGRES_PORT=5432
# URL-encode special characters in the password segment.
DATABASE_URL=postgresql://supplypilot:replace-with-a-generated-database-password@127.0.0.1:5432/supplypilot?schema=public
SEED_STAFF_EMAIL=staff@example.test
SEED_STAFF_PASSWORD=replace-with-a-unique-staff-password
SEED_MANAGER_EMAIL=manager@example.test
SEED_MANAGER_PASSWORD=replace-with-a-unique-manager-password
# Optional reproducible seed date (YYYY-MM-DD); omit to use today's UTC date.
# SEED_REFERENCE_DATE=2026-11-16
# Optional: leave blank to skip the live smoke test. Never use VITE_ for secrets.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Local embedding preflight only; no paid API. First run records a pinned model revision.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
# EMBEDDING_REVISION=<40-character-model-commit>
# EMBEDDING_CACHE_DIR=/absolute/path/to/local/cache

# Day 5 backend feature switches. The dashboard assistant UI is Day 6 work.
RAG_ENABLED=true
ASSISTANT_ENABLED=true
RAG_MIN_SIMILARITY=0.45
# Set RAG_ENABLED=false to return explicit UNAVAILABLE without changing procurement rules.
# Set ASSISTANT_ENABLED=false to disable new runs; manual procurement remains available.
